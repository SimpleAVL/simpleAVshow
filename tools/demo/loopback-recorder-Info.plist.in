<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
<key>CFBundleIdentifier</key><string>org.simpleavshow.loopback-recorder</string>
<key>CFBundleName</key><string>Lighthouse Loopback Recorder</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSMicrophoneUsageDescription</key><string>Record BlackHole loopback channels to verify SimpleAVShow multitrack routing and feed the received stems to OBS.</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
