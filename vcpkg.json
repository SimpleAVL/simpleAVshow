{
  "name": "simpleavshow",
  "version-string": "0.5.0",
  "builtin-baseline": "001713e802f5cf619a64461b918161be6a0634f0",
  "default-features": ["qt", "ffmpeg"],
  "features": {
    "ffmpeg": {
      "description": "Build FFmpeg from source (disable when using a prebuilt shared SDK)",
      "dependencies": [
        { "name": "ffmpeg", "default-features": false, "features": ["avcodec", "avformat", "swresample", "swscale", "ffmpeg"] }
      ]
    },
    "qt": {
      "description": "Build Qt from source (disable when using an existing Qt SDK)",
      "dependencies": [
        { "name": "qtbase", "default-features": false, "features": ["widgets", "concurrent", "network", "testlib", "png", "jpeg"] },
        { "name": "qtbase", "default-features": false, "features": ["windeployqt"], "platform": "windows" }
      ]
    }
  },
  "dependencies": [
    { "name": "libarchive", "default-features": false },
    { "name": "rtaudio", "features": ["asio"], "platform": "windows" },
    { "name": "rtaudio", "features": ["alsa"], "platform": "linux" },
    { "name": "rtaudio", "platform": "osx" },
    "rtmidi",
    { "name": "rtmidi", "features": ["alsa"], "platform": "linux" }
  ]
}
